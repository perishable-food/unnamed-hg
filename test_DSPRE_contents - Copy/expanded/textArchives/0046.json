    {
      "id": "msg_0046_00144",
      "en_US": [
        "Pardon us for the inconvenience...\\n",
        "Please return once you have stopped\\f",
        "being a member of Team Rocket..."
      ]
    },
    {
      "id": "msg_0046_00145",
      "en_US": [
        "You cannot have more than two\\n",
        "legendary Pokémon in the GS Cup."
      ]
    },
    {
      "id": "msg_0046_00146",
      "en_US": [
        "Pardon us for the inconvenience...\\n",
        "but people wearing black clothing,\\f",
        "people who engage in unlawful\\f",
        "activities, and people who are\\f",
        "members of Team Rocket\\f",
        "are barred from participating."
      ]
    },
    {
      "id": "msg_0046_00147",
      "en_US": [
        "Pardon us for the inconvenience.\\r",
        "We have received word from Professor\\n",
        "Elm in New Bark Town that a PICHU\\r",
        "with spiky ears cannot be allowed\\n",
        "to enter.\\r",
        "Please place it in your PC Box and\\n",
        "enter again."
      ]
    },
